<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0, maximum-scale=1.0, user-scalable=no">
  <title>Past Snap</title>

  <link
    rel="stylesheet"
    href="https://unpkg.com/leaflet@1.9.4/dist/leaflet.css"
    crossorigin=""
  />

  <style>
    * { box-sizing: border-box; }
    html, body { margin: 0; height: 100%; font-family: Arial, sans-serif; }
    body { background: #f5f7fb; color: #111827; }

    header {
      height: 64px;
      background: white;
      display: flex;
      align-items: center;
      justify-content: space-between;
      padding: 0 16px;
      border-bottom: 1px solid #e5e7eb;
      position: relative;
      z-index: 1000;
    }

    .brand { font-size: 21px; font-weight: 800; }
    .sub { font-size: 12px; color: #6b7280; margin-top: 2px; }

    #map {
      height: calc(100vh - 64px);
      width: 100%;
      touch-action: pan-x pan-y;
    }

    .locate-btn {
      position: absolute;
      right: 16px;
      bottom: 118px;
      z-index: 1000;
      border: 0;
      border-radius: 999px;
      padding: 13px 16px;
      background: white;
      box-shadow: 0 3px 15px rgba(0,0,0,.18);
      font-weight: 700;
      cursor: pointer;
    }

    .info-card {
      position: absolute;
      left: 50%;
      bottom: 18px;
      transform: translateX(-50%);
      z-index: 1000;
      width: min(92vw, 430px);
      background: white;
      border-radius: 18px;
      padding: 14px;
      box-shadow: 0 5px 24px rgba(0,0,0,.18);
      display: none;
    }

    .info-title { font-size: 17px; font-weight: 800; margin-bottom: 5px; }
    .info-text { font-size: 13px; color: #6b7280; margin-bottom: 12px; }

    button.action {
      width: 100%;
      border: 0;
      border-radius: 12px;
      padding: 13px;
      background: #111827;
      color: white;
      font-size: 15px;
      font-weight: 700;
      cursor: pointer;
    }

    .modal {
      position: fixed;
      inset: 0;
      background: rgba(0,0,0,.55);
      z-index: 3000;
      display: none;
      align-items: flex-end;
      justify-content: center;
    }

    .sheet {
      width: 100%;
      max-width: 520px;
      background: white;
      border-radius: 22px 22px 0 0;
      padding: 18px;
    }

    .sheet h2 { margin: 0 0 6px; font-size: 20px; }
    .sheet p { color: #6b7280; font-size: 13px; }

    input[type="file"] {
      width: 100%;
      margin: 12px 0;
    }

    #preview {
      width: 100%;
      max-height: 280px;
      object-fit: cover;
      border-radius: 14px;
      display: none;
      margin-bottom: 12px;
    }

    .row { display: flex; gap: 10px; }
    .row button { flex: 1; }

    .cancel {
      background: #e5e7eb !important;
      color: #111827 !important;
    }

    .photo-popup img {
      width: 220px;
      max-width: 100%;
      border-radius: 10px;
      display: block;
      margin-bottom: 8px;
    }

    .photo-popup .date {
      font-size: 12px;
      color: #6b7280;
    }

    .leaflet-control-attribution { font-size: 9px; }
  </style>
</head>

<body>
  <header>
    <div>
      <div class="brand">Past Snap</div>
      <div class="sub">Share a photo from where you are</div>
    </div>
  </header>

  <div id="map"></div>

  <button class="locate-btn" id="locateBtn">📍 My Location</button>

  <div class="info-card" id="infoCard">
    <div class="info-title">📍 Selected location</div>
    <div class="info-text" id="coordsText">Tap anywhere on the map to choose a place.</div>
    <button class="action" id="postBtn">📷 Post a Photo Here</button>
  </div>

  <div class="modal" id="uploadModal">
    <div class="sheet">
      <h2>📷 Post a Snap</h2>
      <p id="uploadLocation">Selected location</p>

      <input id="photoInput" type="file" accept="image/*" capture="environment">
      <img id="preview" alt="Preview">

      <div class="row">
        <button class="action cancel" id="cancelBtn">Cancel</button>
        <button class="action" id="uploadBtn">Upload</button>
      </div>
    </div>
  </div>

  <script src="https://unpkg.com/leaflet@1.9.4/dist/leaflet.js" crossorigin=""></script>

  <!-- Supabase JS -->
  <script src="https://cdn.jsdelivr.net/npm/@supabase/supabase-js@2"></script>

  <script>
    /*
      IMPORTANT:
      Put your Supabase Project URL and ANON KEY below.
      These are NOT your service-role/secret key.
    */
    const SUPABASE_URL = "PASTE_YOUR_SUPABASE_PROJECT_URL";
    const SUPABASE_ANON_KEY = "PASTE_YOUR_SUPABASE_ANON_KEY";

    const supabaseReady =
      !SUPABASE_URL.includes("PASTE_") &&
      !SUPABASE_ANON_KEY.includes("PASTE_");

    const supabaseClient = supabaseReady
      ? window.supabase.createClient(SUPABASE_URL, SUPABASE_ANON_KEY)
      : null;

    const map = L.map("map", {
      zoomControl: true,
      attributionControl: true
    }).setView([17.3850, 78.4867], 12);

    L.tileLayer("https://{s}.tile.openstreetmap.org/{z}/{x}/{y}.png", {
      maxZoom: 19,
      attribution: "&copy; OpenStreetMap contributors"
    }).addTo(map);

    let selectedLatLng = null;
    let selectedMarker = null;
    let userMarker = null;

    const infoCard = document.getElementById("infoCard");
    const coordsText = document.getElementById("coordsText");
    const uploadModal = document.getElementById("uploadModal");
    const uploadLocation = document.getElementById("uploadLocation");
    const photoInput = document.getElementById("photoInput");
    const preview = document.getElementById("preview");

    function showSelectedLocation(latlng) {
      selectedLatLng = latlng;

      if (selectedMarker) map.removeLayer(selectedMarker);

      selectedMarker = L.marker(latlng).addTo(map);
      selectedMarker.bindTooltip("Selected location", {permanent: false});

      coordsText.textContent =
        latlng.lat.toFixed(5) + ", " + latlng.lng.toFixed(5);

      infoCard.style.display = "block";
    }

    map.on("click", function(e) {
      showSelectedLocation(e.latlng);
    });

    document.getElementById("locateBtn").addEventListener("click", function() {
      if (!navigator.geolocation) {
        alert("Is device par location available nahi hai.");
        return;
      }

      navigator.geolocation.getCurrentPosition(
        function(position) {
          const lat = position.coords.latitude;
          const lng = position.coords.longitude;
          const latlng = L.latLng(lat, lng);

          map.setView(latlng, 17, { animate: true });

          if (userMarker) map.removeLayer(userMarker);

          userMarker = L.circleMarker(latlng, {
            radius: 9,
            weight: 3
          }).addTo(map);

          userMarker.bindTooltip("Your current location").openTooltip();

          showSelectedLocation(latlng);
        },
        function() {
          alert("Location permission allow karo, phir dobara My Location dabao.");
        },
        {
          enableHighAccuracy: true,
          timeout: 10000,
          maximumAge: 30000
        }
      );
    });

    document.getElementById("postBtn").addEventListener("click", function() {
      if (!selectedLatLng) return;

      uploadLocation.textContent =
        "Location: " +
        selectedLatLng.lat.toFixed(5) +
        ", " +
        selectedLatLng.lng.toFixed(5);

      uploadModal.style.display = "flex";
    });

    document.getElementById("cancelBtn").addEventListener("click", function() {
      uploadModal.style.display = "none";
      photoInput.value = "";
      preview.style.display = "none";
      preview.src = "";
    });

    photoInput.addEventListener("change", function() {
      const file = photoInput.files[0];
      if (!file) return;

      if (!file.type.startsWith("image/")) {
        alert("Sirf image upload karo.");
        photoInput.value = "";
        return;
      }

      if (file.size > 8 * 1024 * 1024) {
        alert("Image 8 MB se chhoti honi chahiye.");
        photoInput.value = "";
        return;
      }

      preview.src = URL.createObjectURL(file);
      preview.style.display = "block";
    });

    document.getElementById("uploadBtn").addEventListener("click", async function() {
      if (!supabaseReady) {
        alert("Pehle Supabase URL aur ANON KEY index.html me add karo.");
        return;
      }

      if (!selectedLatLng) {
        alert("Pehle map par location select karo.");
        return;
      }

      const file = photoInput.files[0];

      if (!file) {
        alert("Pehle photo select/take karo.");
        return;
      }

      const uploadBtn = document.getElementById("uploadBtn");
      uploadBtn.disabled = true;
      uploadBtn.textContent = "Uploading...";

      try {
        const safeName = file.name.replace(/[^a-zA-Z0-9._-]/g, "_");
        const filePath =
          Date.now() + "-" + Math.random().toString(36).slice(2) + "-" + safeName;

        const { error: storageError } = await supabaseClient
          .storage
          .from("past-snaps")
          .upload(filePath, file, {
            cacheControl: "3600",
            upsert: false,
            contentType: file.type
          });

        if (storageError) throw storageError;

        const { data: publicData } = supabaseClient
          .storage
          .from("past-snaps")
          .getPublicUrl(filePath);

        const imageUrl = publicData.publicUrl;

        const { error: dbError } = await supabaseClient
          .from("snaps")
          .insert({
            latitude: selectedLatLng.lat,
            longitude: selectedLatLng.lng,
            image_url: imageUrl
          });

        if (dbError) throw dbError;

        alert("✅ Snap uploaded!");

        uploadModal.style.display = "none";
        photoInput.value = "";
        preview.style.display = "none";
        preview.src = "";

        loadSnaps();

      } catch (error) {
        console.error(error);
        alert("Upload failed: " + (error.message || "Unknown error"));
      } finally {
        uploadBtn.disabled = false;
        uploadBtn.textContent = "Upload";
      }
    });

    async function loadSnaps() {
      if (!supabaseReady) return;

      const { data, error } = await supabaseClient
        .from("snaps")
        .select("*")
        .order("created_at", { ascending: false });

      if (error) {
        console.error("Could not load snaps:", error);
        return;
      }

      data.forEach(snap => {
        const marker = L.marker([snap.latitude, snap.longitude]).addTo(map);

        const date = snap.created_at
          ? new Date(snap.created_at).toLocaleString()
          : "";

        marker.bindPopup(`
          <div class="photo-popup">
            <img src="${escapeHtml(snap.image_url)}" alt="Past Snap">
            <div class="date">${escapeHtml(date)}</div>
          </div>
        `);
      });
    }

    function escapeHtml(value) {
      return String(value)
        .replaceAll("&", "&amp;")
        .replaceAll("<", "&lt;")
        .replaceAll(">", "&gt;")
        .replaceAll('"', "&quot;")
        .replaceAll("'", "&#039;");
    }

    loadSnaps();
  </script>
</body>
</html>
